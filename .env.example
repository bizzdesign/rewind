# Optional: a built-in connection for development, so you skip the
# connection screen. Copy to .env and fill in from your environment's
# https://<your-environment>.unify.cloud/env.js, plus the client ID of an
# Authorization code app client that lists http://localhost:<port> as a
# redirect URL (Unify Management, App clients). Never commit .env.

# appSyncUrl
VITE_UNIFY_GRAPHQL_URL=
# cognitoDomain
VITE_COGNITO_DOMAIN=
# cognitoUserPoolId (its prefix is the region)
VITE_COGNITO_USER_POOL_ID=
# your Rewind app client's ID
VITE_COGNITO_CLIENT_ID=
